# Supabase frontend auth/data client (preferred for migration).
# Copy to .env and set values from Supabase Project Settings -> API Keys / Data API.
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=sb_publishable_xxx

# Legacy API backend base URL (optional during migration/hybrid mode).
# VITE_API_URL=http://localhost:3001
#
# That API must allow this frontend origin via CORS. Set NODE_ENV, JWT_SECRET, DATABASE_URL, and
# optionally CORS_ORIGIN on the API host (see server/README.md, section Production API environment).
