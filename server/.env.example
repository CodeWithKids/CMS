# Template: copy to .env and fill in your real values.
# Do NOT put real passwords in this file (it may be committed to Git).

# Required: your Postgres connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://user:password@localhost:5432/cwk_hub"

# --- Local development (default) ---
# NODE_ENV=development
# Leave CORS_ORIGIN unset locally: the API allows any browser origin.

# --- Production (set on the API host: Railway, Fly.io, VPS, Docker — not on the static SPA host) ---
#
# NODE_ENV=production
#
# JWT_SECRET — required in production (long random string, e.g. openssl rand -base64 32).
# The server exits on boot if JWT_SECRET is missing or still the dev default.
# JWT_SECRET=
#
# CORS_ORIGIN — comma-separated list of frontend origins that may call this API.
# Set this on the same service that runs Express. The static app on Vercel does not set CORS.
# Example (production app + Vercel preview):
# CORS_ORIGIN=https://app.codewithkids.africa,https://your-app-git-main-codewithkids.vercel.app
#
# If you omit CORS_ORIGIN in production, the API falls back to defaults in src/config/corsOrigins.ts
# (currently https://app.codewithkids.africa only). Add your real Hub URL here so browsers on your domain are allowed.
#
# After changing env vars on the host, trigger a new deploy / restart so the process picks them up.

# Optional: API port (default 3001)
# PORT=3001

# --- Optional: Supabase auth provisioning (no confirmation email; avoids built-in SMTP rate limits) ---
# Used by POST /v1/admin/provision-supabase-user when admins create parent/team/org users from the SPA
# while logged in with Supabase. Same values as in the Supabase Dashboard → Settings → API (JWT Secret;
# service_role is secret — never put it in Vite env).
#
# SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# SUPABASE_JWT_SECRET=your-jwt-signing-secret
#
# When the SPA sends Supabase session tokens (hybrid login), these three are required for admin API routes
# (pending signup approve/reject, overview, etc.) — same values as Dashboard → Settings → API.
