# Template: copy to .env and fill in your real values.
# Do NOT put real passwords in this file (it may be committed to Git).

# Required: your Postgres connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://user:password@localhost:5432/cwk_hub"

# --- Local development (default) ---
# NODE_ENV=development
# Leave CORS_ORIGIN unset locally: the API allows any browser origin.

# --- Production (set on the API host: Render, Railway, VPS — not on Vercel) ---
#
# NODE_ENV=production
#
# JWT_SECRET — required in production (long random string, e.g. openssl rand -base64 32).
# The server exits on boot if JWT_SECRET is missing or still the dev default.
# JWT_SECRET=
#
# CORS_ORIGIN — comma-separated list of frontend origins that may call this API.
# Set this on the same service that runs Express. The static app on Vercel does not set CORS.
# Example (production app + Vercel preview):
# CORS_ORIGIN=https://app.codewithkids.africa,https://your-app-git-main-codewithkids.vercel.app
#
# If you omit CORS_ORIGIN in production, defaults include:
#   https://app.codewithkids.africa
#   https://cwk-hub.onrender.com
#
# After changing env vars on the host, trigger a new deploy / restart so the process picks them up.

# Optional: API port (default 3001)
# PORT=3001
